# ---------------------------------------------------------------------------
# Frontend (Vite) — safe to expose in the browser bundle.
# Set these in Netlify: Site settings > Environment variables.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://wnzxvdfskmivbyqadtll.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Netlify Functions (server-side only). NEVER prefix these with VITE_ —
# that would ship them to the client bundle.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://wnzxvdfskmivbyqadtll.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Alpaca — paper keys are fine for data ingestion, no funded account needed.
# Generate at https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://data.alpaca.markets

# Alert delivery (pick one to start; the code checks for whichever is set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
