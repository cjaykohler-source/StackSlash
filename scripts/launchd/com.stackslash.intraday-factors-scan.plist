<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stackslash.intraday-factors-scan</string>

    <!-- Runs intraday-factors-scan on this host instead of Netlify, whose ~30 s
         scheduled-function limit cut it off and re-ran it 2-3x per slot.
         launchd never starts a second instance while one is running. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ckohler/StackSlash/scripts/run-netlify-job.sh</string>
        <string>intraday-factors-scan</string>
        <string>0900</string>
        <string>1655</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ckohler/StackSlash</string>

    <!-- Every 5 min on the clock (minutes 0,5,..55, so Netlify's
         intraday-flip-scan at +2 min still reads a fresh state); the runner
         skips unless it's a weekday 09:00-16:55 ET, and the function itself
         no-ops outside the regular session. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>25</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-intraday-factors-scan/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-intraday-factors-scan/launchd.err.log</string>
</dict>
</plist>
