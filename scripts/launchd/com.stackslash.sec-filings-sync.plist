<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stackslash.sec-filings-sync</string>

    <!-- SEC filings (offerings, 8-K, SC 13D/13G) from EDGAR's daily form
         index: 07:30 and 17:30 ET weekdays, the evening run before eod-scan
         (17:45) so tonight's dossiers see today's offering filings. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ckohler/StackSlash/scripts/run-netlify-job.sh</string>
        <string>sec-filings-sync</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ckohler/StackSlash</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>17</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-sec-filings-sync/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-sec-filings-sync/launchd.err.log</string>
</dict>
</plist>
