<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stackslash.charter-api</string>

    <!-- Charter API for the /charter page. Always on (KeepAlive); binds
         127.0.0.1:8787 only. Remote access is Tailscale Serve (tailnet-only),
         configured separately with: tailscale serve --bg --https=443 http://127.0.0.1:8787
         See scripts/run-charter-api.sh and research/charter_api/server.py. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ckohler/StackSlash/scripts/run-charter-api.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ckohler/StackSlash</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-charter-api/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-charter-api/launchd.err.log</string>
</dict>
</plist>
