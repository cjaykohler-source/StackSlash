<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stackslash.intraday-flip-scan</string>

    <!-- Live intraday alerts: every 5 min at +2 min after intraday-factors-scan; the runner skips outside 09:35-16:00 ET weekdays. launchd never starts a second instance while one runs. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ckohler/StackSlash/scripts/run-netlify-job.sh</string>
        <string>intraday-flip-scan</string>
        <string>0935</string>
        <string>1600</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ckohler/StackSlash</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>2</integer></dict>
        <dict><key>Minute</key><integer>7</integer></dict>
        <dict><key>Minute</key><integer>12</integer></dict>
        <dict><key>Minute</key><integer>17</integer></dict>
        <dict><key>Minute</key><integer>22</integer></dict>
        <dict><key>Minute</key><integer>27</integer></dict>
        <dict><key>Minute</key><integer>32</integer></dict>
        <dict><key>Minute</key><integer>37</integer></dict>
        <dict><key>Minute</key><integer>42</integer></dict>
        <dict><key>Minute</key><integer>47</integer></dict>
        <dict><key>Minute</key><integer>52</integer></dict>
        <dict><key>Minute</key><integer>57</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-intraday-flip-scan/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ckohler/Library/Logs/stackslash-intraday-flip-scan/launchd.err.log</string>
</dict>
</plist>
