# Same Supabase project as the main app — this worker writes into the same
# tables (trigger_events etc.) using the service-role key, same as the
# Netlify functions do.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same Alpaca keys as the main app work fine here — paper keys, data-only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# IEX feed (free tier). Use wss://stream.data.alpaca.markets/v2/sip instead
# if you're on a paid plan with full consolidated-tape access.
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# Name of the seeded `triggers` row this worker fires into. Its
# cooldown_minutes column governs per-symbol re-fire suppression.
OUTLIER_TRIGGER_NAME=realtime_outlier_zscore

# EWMA smoothing factor for the rolling mean/variance of per-tick returns.
# Smaller = longer effective memory (slower to adapt, less noisy).
# ~0.05 gives an effective window on the order of a few dozen ticks.
EWMA_ALPHA=0.05

# Standard deviations from the rolling mean a tick-to-tick return must
# cross to count as an outlier. 3.0 matches the Black Swan paper's method.
Z_SCORE_THRESHOLD=3.0

# Minimum ticks observed for a symbol before its rolling stats are trusted
# enough to evaluate — avoids firing on startup noise.
MIN_TICKS_BEFORE_EVAL=30

# How often (ms) to write a heartbeat to job_runs so the dashboard/ops can
# see this worker is alive, distinct from the scheduled-function jobs.
HEARTBEAT_INTERVAL_MS=60000
