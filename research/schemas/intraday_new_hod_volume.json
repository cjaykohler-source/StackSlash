{
  "name": "intraday_new_hod_volume",
  "notes": "Candidate live buy alert: sets a fresh high of day after the first 30 minutes, above VWAP, on a 3x minute volume spike with real cumulative volume. $10k+/day band.",
  "universe": {
    "price_min": 0.1,
    "price_max": 5.0,
    "min_dollar_vol_20d": 10000,
    "exchanges": [
      "NYSE",
      "NASDAQ",
      "AMEX",
      "ARCA",
      "BATS"
    ],
    "include_delisted": true
  },
  "window": {
    "start": "10:00",
    "end": "15:00"
  },
  "entry": {
    "all": [
      {
        "field": "pct_off_hod",
        "op": ">=",
        "value": -0.001
      },
      {
        "field": "minutes_since_open",
        "op": ">=",
        "value": 30
      },
      {
        "field": "bar_vol_spike",
        "op": ">=",
        "value": 3
      },
      {
        "field": "cum_vol_vs_adv20",
        "op": ">=",
        "value": 0.3
      },
      {
        "field": "dist_vwap",
        "op": ">",
        "value": 0
      }
    ]
  },
  "first_match_only": true,
  "exit": {
    "horizons_min": [
      15,
      30,
      60,
      120
    ]
  },
  "cost": {
    "flat_pct": 0.01
  }
}
