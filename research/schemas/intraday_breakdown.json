{
  "name": "intraday_breakdown",
  "notes": "Candidate live SELL/avoid alert: down 5%+ from the open, 8%+ off the high, 2%+ below VWAP, on a 3x minute volume spike. For a sell-side signal, 'useful' means returns WORSE than the random control.",
  "universe": {
    "price_min": 0.1,
    "price_max": 5.0,
    "min_dollar_vol_20d": 10000,
    "exchanges": [
      "NYSE",
      "NASDAQ",
      "AMEX",
      "ARCA",
      "BATS"
    ],
    "include_delisted": true
  },
  "window": {
    "start": "09:45",
    "end": "15:00"
  },
  "entry": {
    "all": [
      {
        "field": "session_ret",
        "op": "<=",
        "value": -0.05
      },
      {
        "field": "pct_off_hod",
        "op": "<=",
        "value": -0.08
      },
      {
        "field": "dist_vwap",
        "op": "<",
        "value": -0.02
      },
      {
        "field": "bar_vol_spike",
        "op": ">=",
        "value": 3
      }
    ]
  },
  "first_match_only": true,
  "exit": {
    "horizons_min": [
      15,
      30,
      60,
      120
    ]
  },
  "cost": {
    "flat_pct": 0.01
  }
}
